# Copy to .env.local for local development. Never commit real secrets.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://annika-hk777.vercel.app

# Required for email/password registration, sessions, and social auth user storage
MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Required to enable Google sign-in/sign-up
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required to enable GitHub sign-in/sign-up
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
